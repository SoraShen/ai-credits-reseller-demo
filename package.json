{
  "name": "vodacom-ai-credits-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Huawei Cloud frontend demo: Vodacom AI Credits storefront + Pricing Studio",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:mtn": "NEXT_PUBLIC_BRAND=mtn NEXT_PUBLIC_BASE_PATH=/MTN next build",
    "build:rain": "NEXT_PUBLIC_BRAND=rain NEXT_PUBLIC_BASE_PATH=/rain next build",
    "start": "next start",
    "start:mtn": "NEXT_PUBLIC_BRAND=mtn NEXT_PUBLIC_BASE_PATH=/MTN next start -p 3001",
    "start:rain": "NEXT_PUBLIC_BRAND=rain NEXT_PUBLIC_BASE_PATH=/rain next start -p 3002",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify:pricing": "node --experimental-loader ./scripts/ts-loader.mjs scripts/verify-pricing.ts",
    "check": "npm run lint && npm run typecheck && npm run verify:pricing && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.6.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
